# Local SQLite database used by Prisma.
DATABASE_URL=file:./dev.db
# Public Convex deployment URL for the realtime spike (not a secret).
NEXT_PUBLIC_CONVEX_URL=https://adamant-badger-403.convex.cloud
# Convex site URL (HTTP actions/dashboard integration, if needed).
CONVEX_SITE_URL=https://adamant-badger-403.convex.site
# Durable BullMQ schedule synchronization (requires DURABLE_RUNS_ENABLED=true).
DURABLE_SCHEDULES_ENABLED=false
