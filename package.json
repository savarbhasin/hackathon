{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mcp": "tsx watch --env-file=.env.local server/mcp.ts",
    "dev:worker": "tsx watch --env-file=.env.local worker/agent-runs.ts",
    "worker": "tsx --env-file=.env.local worker/agent-runs.ts",
    "worker:prod": "tsx worker/agent-runs.ts",
    "enqueue:run": "tsx --env-file=.env.local worker/enqueue-agent-run.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build:web": "node scripts/build-cloudflare-web.mjs",
    "cf:preview:web": "npm run cf:build:web && opennextjs-cloudflare preview",
    "cf:deploy:web": "npm run cf:build:web && opennextjs-cloudflare deploy",
    "cf:dev:mcp": "wrangler dev --config wrangler.mcp.jsonc",
    "cf:deploy:mcp": "wrangler deploy --config wrangler.mcp.jsonc"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "bullmq": "^5.81.3",
    "convex": "^1.45.0",
    "croner": "^10.0.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.127.0"
  }
}
