generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Mission {
  id        String     @id @default(cuid())
  title     String
  goal      String
  status    String     @default("planning")
  createdAt DateTime   @default(now())
  tasks     Task[]
  documents Document[]
}

model Task {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  title          String
  detail         String?
  role           String
  agentPrompt    String?
  column         String   @default("backlog")
  sessionId      String?
  turnId         String?
  lastSeq        Int      @default(0)
  dependsOn      String   @default("[]")
  handoff        String?
  output         String?
  error          String?
  pendingActions String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events    TaskEvent[]
  documents Document[]

  @@index([missionId])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   String
  createdAt DateTime @default(now())

  @@unique([taskId, seq])
}

model Schedule {
  id        String    @id @default(cuid())
  name      String
  cronExpr  String
  prompt    String
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

model Document {
  id         String   @id @default(cuid())
  title      String
  content    String
  authorRole String
  kind       String   @default("artifact")
  missionId  String?
  mission    Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([missionId])
  @@index([taskId])
  @@index([kind])
  @@index([updatedAt])
}

model Conversation {
  id        String        @id @default(cuid())
  title     String
  sessionId String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  tools          String       @default("[]")
  status         String?
  pauseActions   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AgentProfile {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  instructions String
  isDefault    Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model Setting {
  key   String @id
  value String
}
