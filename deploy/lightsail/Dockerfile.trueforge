FROM node:24-slim

WORKDIR /app
ENV NODE_ENV=production \
    STANDALONE=false \
    HOST=0.0.0.0 \
    PORT=8790

RUN npm install --omit=dev @truefoundry/trueforge@0.1.4 \
    && npm cache clean --force

RUN groupadd --gid 10001 trueforge \
    && useradd --uid 10001 --gid trueforge --shell /usr/sbin/nologin trueforge \
    && chown -R trueforge:trueforge /app

USER 10001:10001
EXPOSE 8790
CMD ["node", "node_modules/@truefoundry/trueforge/dist/main.js"]
